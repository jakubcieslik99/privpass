{
  "name": "privpass-server",
  "version": "1.15.2",
  "description": "PrivPASS",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "docker": "cross-env DIR=privpass-server docker-compose -f docker-compose.dev.yml -p privpass-server up --force-recreate",
    "dev": "cross-env ENV=development nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "test:typecheck": "tsc -p test/tsconfig.json",
    "test": "cross-env ENV=testing node --experimental-vm-modules node_modules/jest/bin/jest --watchAll",
    "test:ci": "cross-env ENV=testing node --experimental-vm-modules node_modules/jest/bin/jest",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --ignore-path ../.gitignore --write \"**/*.+(js|ts)\"",
    "update:all": "corepack up && pnpm update"
  },
  "author": "Jakub Cieślik",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-slow-down": "^3.1.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "nodemailer": "^8.0.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "voucher-code-generator": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/voucher-code-generator": "^1.1.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
